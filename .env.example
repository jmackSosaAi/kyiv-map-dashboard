# Google Cloud API key with these APIs enabled:
#   - Maps JavaScript API
#   - Places API (new — required for autocomplete + live details)
#   - Geocoding API
#   - Directions API
# Get a key: https://console.cloud.google.com/apis/credentials
# Restrict the key to your production domain in Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# (Optional) Google Calendar OAuth — for future direct-sync feature.
# Leave blank to use the .ics export workflow instead.
# Setup guide: docs/CALENDAR_SETUP.md
VITE_GOOGLE_CALENDAR_CLIENT_ID=
VITE_GOOGLE_CALENDAR_REDIRECT_URI=
